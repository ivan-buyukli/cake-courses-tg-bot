# Local values belong in .dev.vars. Existing secrets can be retained.
# Production secrets must be configured separately; do not upload this local APP_ENV.
BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Exactly 32 random bytes encoded as base64url (43 characters).
ENCRYPTION_KEY=
USER_HASH_SECRET=
# Both admins' numeric Telegram IDs, comma-separated.
# ADMIN_USER_ID is accepted when ADMIN_USER_IDS is absent.
# Empty is allowed locally (no admins); production requires at least one ID.
ADMIN_USER_IDS=
APP_ENV=development
# IANA timezone used for displayed dates; defaults to Europe/Berlin.
CAMPAIGN_TIMEZONE=Europe/Berlin
# Deferred: HTTPS public course URL.
COURSE_WEBSITE_URL=
